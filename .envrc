# Dim direnv status messages
export DIRENV_LOG_FORMAT=$'\033[2mdirenv: %s\033[0m'
export zmk="$HOME/orodruin/zmk/zmk-workspace"
export orbita="$zmk/modules/zmk/zmk-orbita-layout"
export tcherta="$zmk/modules/zmk/zmk-keyboard-tcherta/boards/shields/tcherta"
export plenka="$zmk/modules/zmk/zmk-keyboard-tcherta/boards/shields/plenka"

# Also rebuild if other local flake inputs change
watch_file nix/*

# Use flake
use flake
